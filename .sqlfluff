[sqlfluff]
# dbt templater so macros like normalize_player_name resolve instead of parsing as
# undefined jinja. dev is the lintable target — prod needs live Postgres credentials.
templater = dbt
dialect = duckdb
# Matches ruff's line-length so Python and SQL agree.
max_line_length = 100
exclude_rules = RF04, ST06

[sqlfluff:templater:dbt]
project_dir = dbt_project
profiles_dir = dbt_project
target = dev

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower
