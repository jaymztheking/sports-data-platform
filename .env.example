# --- Local dev (DuckDB) ---
# dbt dev target writes here; ci uses :memory:. No server needed for dev/ci.
NFL_DUCKDB_PATH=nfl.duckdb
NFL_DATA_DIR=data/raw
NFL_DEFAULT_SEASON=2025

# --- Prod (PostgreSQL on k3s) — used only by the `prod` dbt target ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nfl
POSTGRES_PASSWORD=changeme
POSTGRES_DB=nfl
POSTGRES_SCHEMA=marts

# --- k3s (prod, S011+) ---
KUBECONFIG_PATH=~/.kube/config
